Alice.child_born_year = START_YEAR + 3;
Alice.child_expenses = 30 * 1000;

// Изменить Alice_expenses:
void Alice_expenses(const double inflation, const int year)
{
    Alice.necessary_expenses *= inflation;
    Alice.account -= Alice.necessary_expenses;
    
    // Добавляем расходы на ребенка
    if (year >= Alice.child_born_year) {
        Alice.account -= Alice.child_expenses;
        Alice.child_expenses *= inflation; // Индексируем расходы на ребенка
    }
    
    Alice.account -= Alice.monthly_payment;
}
