Задание 10: Сравнить с инвестициями в акции
Условие: Добавить третьего персонажа - Карла, который инвестирует в акции с доходностью 20% годовых, но с риском.

c
Person Carl;

void Carl_init()
{
    Carl.capital = 0;
    Carl.account = 0;
    Carl.salary = 300 * 1000;
    Carl.necessary_expenses = 50 * 1000;
    Carl.contribution = 1500 * 1000;
    Carl.monthly_payment = 50 * 1000;
    Carl.rate_contribution = 1.0; // Без гарантированной доходности
}

double stock_growth()
{
    int chance = rand() % 100;
    if (chance < 70) { // 70% вероятность роста
        return 1.02; // 2% в месяц (≈ 27% годовых)
    } else if (chance < 90) { // 20% вероятность просадки
        return 0.98; // -2% в месяц
    } else { // 10% вероятность кризиса
        return 0.90; // -10% в месяц
    }
}

void Carl_contribution()
{
    Carl.contribution = (Carl.contribution + Carl.account) * stock_growth();
}

