Задание 5: Учесть валютные сбережения
Условие: Боб хранит 30% своих сбережений в долларах с ростом 5% годовых.

c
// В структуру Person добавить:
Money usd_savings; // Сбережения в долларах
double usd_growth_rate; // Рост курса доллара
double usd_allocation; // Доля в долларах

// В Bob_init добавить:
Bob.usd_savings = 0;
Bob.usd_growth_rate = 1.05; // 5% в год
Bob.usd_allocation = 0.3; // 30%

// Изменить Bob_contribution:
void Bob_contribution()
{
    // Переводим часть денег в доллары
    if (Bob.account > 0) {
        Money to_usd = Bob.account * Bob.usd_allocation;
        Bob.usd_savings += to_usd;
        Bob.account -= to_usd;
    }
    
    // Рублевая часть
    Bob.contribution = (Bob.contribution + Bob.account) * Bob.rate_contribution;
    
    // Долларовая часть растет
    if (month == 1) {
        Bob.usd_savings *= Bob.usd_growth_rate;
    }
}

// Изменить Bob_capital:
Bob.capital = Bob.contribution + Bob.usd_savings;
