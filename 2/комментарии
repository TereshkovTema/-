#include <stdio.h>      // Подключение стандартной библиотеки ввода-вывода
#include <stdlib.h>     // Подключение стандартной библиотеки для работы с памятью и рандомом

typedef unsigned long long int Money; // Создание псевдонима Money для типа unsigned long long int

const int START_YEAR = 2025;   // Год начала симуляции
const int START_MONTH = 9;     // Месяц начала симуляции (сентябрь)
const int PERIOD = 30;         // Период симуляции в годах (30 лет)

// Определение структуры Person для хранения данных о человеке
typedef struct Person {
    long long int account;        // Текущий счет (свободные деньги)
    Money capital;               // Общий капитал (вклад + стоимость имущества)
    Money premia;                // Премия
    Money salary;                // Зарплата
    Money monthly_payment;       // Ежемесячный платеж (ипотека или аренда)
    Money necessary_expenses;    // Необходимые траты на жизнь
    Money contribution;          // Сумма на вкладе/инвестициях
    Money cost_house;            // Стоимость дома
    double rate_contribution;    // Месячная ставка по вкладу (множитель)
} Person;

// Объявление глобальных переменных для Алисы и Боба
Person Alice;
Person Bob;

// Функция инициализации данных для Боба
void Bob_init()
{
    Bob.capital = 0;                        // Начальный капитал = 0
    Bob.account = 0;                        // Начальный счет = 0
    Bob.salary = 300 * 1000;                // Зарплата 300,000 рублей
    Bob.monthly_payment = 50 * 1000;        // Аренда 50,000 рублей в месяц
    Bob.necessary_expenses = 50 * 1000;     // Необходимые траты 50,000 рублей
    Bob.contribution = 1500 * 1000;         // Начальный вклад 1,500,000 рублей
    Bob.rate_contribution = 1.014;          // Месячная ставка 1.4% (1.014 множитель)
}

// Функция инициализации данных для Алисы
void Alice_init()
{
    Alice.capital = 0;                       // Начальный капитал = 0
    Alice.account = 0;                       // Начальный счет = 0
    Alice.salary = 300 * 1000;               // Зарплата 300,000 рублей
    Alice.premia = 300 * 1000/2 ;            // Премия 150,000 рублей (половина зарплаты)
    Alice.monthly_payment = 192466;          // Ипотечный платеж 192,466 рублей
    Alice.necessary_expenses = 50 * 1000;    // Необходимые траты 50,000 рублей
    Alice.contribution = 0;                  // Начальный вклад = 0
    Alice.cost_house = 15 * 1000 * 1000;     // Стоимость дома 15,000,000 рублей
    Alice.rate_contribution = 1.014;         // Месячная ставка 1.4% (1.014 множитель)
}

// Функция генерации случайной инфляции
double search_inflation()
{ 
    int probability = (rand() % 100);        // Генерация случайного числа от 0 до 99
    double inflation;                        // Переменная для хранения инфляции

    if (probability > 90) {                  // 10% вероятность (числа 90-99)
        inflation = (1001 + rand() % 2);     // Инфляция 0.1-0.2% в месяц
    }
    if (probability <= 90 && probability > 60) { // 30% вероятность (числа 60-89)
        inflation=(1004 + rand() % 2);       // Инфляция 0.4-0.5% в месяц
    }
    if (probability <= 60 && probability > 10) { // 50% вероятность (числа 10-59)
        inflation = (1007 + rand() % 2);     // Инфляция 0.7-0.8% в месяц
    }
    if (probability <= 10) {                 // 10% вероятность (числа 0-9)
        inflation = (1010 + rand() % 4);     // Инфляция 1.0-1.3% в месяц
    }
    return((double) inflation / 1000.0);     // Преобразование в множитель (1.001-1.013)
}

// Функция индексации зарплаты
double indexation()
{
    return((double) (100 + rand() % 9) / 100.0); // Возвращает множитель от 1.00 до 1.08
}

// Функция начисления зарплаты Бобу
void Bob_salary(const int month)
{
    if (month == 1) {                        // Если январь
        Bob.salary *= indexation();          // Индексируем зарплату
    }
    Bob.account = Bob.salary;                // Начисляем зарплату на счет
}

// Функция начисления зарплаты Алисе
void Alice_salary(const int month)
{
    if (month == 1) {                        // Если январь
        Alice.salary *= indexation();        // Индексируем зарплату
    }

    Alice.account = Alice.salary;            // Начисляем базовую зарплату

    if (month % 3 == 0) {                    // Если месяц кратен 3 (каждый квартал)
        Alice.account += 4*1000;             // Добавляем 4,000 рублей
    }
    if (month == 12) {                       // Если декабрь
        Alice.account += Alice.salary;       // Добавляем 13-ю зарплату
    }
    if (month % 3 == 0) {                    // Если месяц кратен 3 (каждый квартал)
        Alice.account += Alice.premia;       // Добавляем премию
    }
}

// Функция учета расходов Боба
void Bob_expenses(const double inflation)
{
    Bob.necessary_expenses *= inflation;     // Увеличиваем траты на инфляцию
    Bob.account -= Bob.necessary_expenses;   // Вычитаем траты из счета
    Bob.monthly_payment *= inflation;        // Увеличиваем аренду на инфляцию
    Bob.account -= Bob.monthly_payment;      // Вычитаем аренду из счета
}

// Функция учета расходов Алисы
void Alice_expenses(const double inflation)
{
    Alice.necessary_expenses *= inflation;   // Увеличиваем траты на инфляцию
    Alice.account -= Alice.necessary_expenses; // Вычитаем траты из счета
    Alice.account -= Alice.monthly_payment;  // Вычитаем ипотеку из счета (фиксированная)
}

// Функция начисления процентов по вкладу Боба
void Bob_contribution()
{
    // Добавляем остаток счета к вкладу и начисляем проценты
    Bob.contribution = (Bob.contribution + Bob.account) * Bob.rate_contribution;
}

// Функция начисления процентов по вкладу Алисы
void Alice_contribution()
{
    // Добавляем остаток счета к вкладу и начисляем проценты
    Alice.contribution = (Alice.contribution + Alice.account) * Alice.rate_contribution;
}

// Функция расчета капитала Алисы
void Alice_capital(const double inflation)
{
    Alice.cost_house *= inflation;           // Индексируем стоимость дома на инфляцию
    Alice.capital = Alice.contribution + Alice.cost_house; // Капитал = вклад + стоимость дома
}

// Функция расчета капитала Боба
void Bob_capital(const double inflation)
{
    Bob.capital = Bob.contribution;          // Капитал Боба = только вклад (арендует)
}

// Основная функция симуляции
void simulation()
{
    int month = START_MONTH, year = START_YEAR; // Установка начальной даты

    // Цикл симуляции на 30 лет
    while (year < START_YEAR + PERIOD) {

        Money inflation = search_inflation(); // Получаем текущую инфляцию

        // Обработка Алисы
        Alice_salary(month);                 // Начисляем зарплату
        Alice_expenses(inflation);           // Учитываем расходы
        Alice_contribution();                // Начисляем проценты по вкладу
        Alice_capital(inflation);            // Пересчитываем капитал

        // Обработка Боба
        Bob_salary(month);                   // Начисляем зарплату
        Bob_expenses(inflation);             // Учитываем расходы
        Bob_contribution();                  // Начисляем проценты по вкладу
        Bob_capital(inflation);              // Пересчитываем капитал

        month++;                            // Переходим к следующему месяцу
        if (month > 12) {                   // Если месяц больше декабря
            year++;                         // Увеличиваем год
            month = 1;                      // Сбрасываем месяц на январь
        }
    }
}

// Функция вывода результатов
void print()
{
    printf("%lld\n", Alice.capital);        // Вывод капитала Алисы
    printf("%lld\n", Bob.capital);          // Вывод капитала Боба

    // Определение победителя
    if (Alice.capital > Bob.capital) {
        printf("Alice win!\n");             // Алиса выиграла
    } else {
        printf("Bob win!\n");               // Боб выиграл
    }
}

// Главная функция программы
int main()
{
    Bob_init();     // Инициализация данных Боба
    Alice_init();   // Инициализация данных Алисы

    simulation();   // Запуск симуляции на 30 лет

    print();        // Вывод результатов

    return 0;       // Завершение программы
}
