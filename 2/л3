    printf("  Финальная зарплата:    %llu руб.\n", Alice.salary);
    printf("  Финальная премия:      %llu руб.\n", Alice.premia);
    printf("  Накопления на вкладе:  %llu руб.\n", Alice.contribution);
    printf("  Стоимость дома:        %llu руб.\n", Alice.cost_house);
    printf("  Пенсионные накопления: %llu руб.\n", Alice.pension_savings);
    printf("  Ипотека погашена:      %s\n", Alice.mortgage_paid ? "ДА" : "НЕТ");
    
    printf("\nБОБ (аренда + инвестиции):\n");
    printf("  Итоговый капитал:      %llu руб.\n", Bob.capital);
    printf("  Финальная зарплата:    %llu руб.\n", Bob.salary);
    printf("  Рублевые накопления:   %llu руб.\n", Bob.contribution);
    printf("  Валютные накопления:   %llu руб.\n", Bob.usd_savings);
    
    printf("\nКАРЛ (инвестиции в акции):\n");
    printf("  Итоговый капитал:      %llu руб.\n", Carl.capital);
    printf("  Финальная зарплата:    %llu руб.\n", Carl.salary);
    
    printf("\n═══════════════════════════════════════════════\n");
    printf("РЕЗУЛЬТАТЫ СРАВНЕНИЯ\n");
    printf("═══════════════════════════════════════════════\n");
    
    Money max_capital = Alice.capital;
    if (Bob.capital > max_capital) max_capital = Bob.capital;
    if (Carl.capital > max_capital) max_capital = Carl.capital;
    
    if (Alice.capital == max_capital) {
        printf("🏆 ПОБЕДИТЕЛЬ: АЛИСА!\n");
        Money second_best = (Bob.capital > Carl.capital) ? Bob.capital : Carl.capital;
        printf("   Преимущество: %llu руб.\n", Alice.capital - second_best);
    } else if (Bob.capital == max_capital) {
        printf("🏆 ПОБЕДИТЕЛЬ: БОБ!\n");
        Money second_best = (Alice.capital > Carl.capital) ? Alice.capital : Carl.capital;
        printf("   Преимущество: %llu руб.\n", Bob.capital - second_best);
    } else {
        printf("🏆 ПОБЕДИТЕЛЬ: КАРЛ!\n");
        Money second_best = (Alice.capital > Bob.capital) ? Alice.capital : Bob.capital;
        printf("   Преимущество: %llu руб.\n", Carl.capital - second_best);
    }
    
    printf("\nОтносительная эффективность:\n");
    printf("  Алиса: %.1f%% от максимального капитала\n", (double)Alice.capital / max_capital * 100);
    printf("  Боб:   %.1f%% от максимального капитала\n", (double)Bob.capital / max_capital * 100);
    printf("  Карл:  %.1f%% от максимального капитала\n", (double)Carl.capital / max_capital * 100);
    
    print_graph();
}

int main()
{
    srand(time(NULL));
    
    printf("╔══════════════════════════════════════════════╗\n");
